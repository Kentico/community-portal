<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageVersion Include="Enums.NET" Version="5.0.0" />
    <PackageVersion Include="Htmx" Version="1.12.0" />
    <PackageVersion Include="Htmx.TagHelpers" Version="1.12.0" />
    <PackageVersion Include="Kentico.Xperience.Admin" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.AzureStorage" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.Cloud" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.ManagementApi" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.ComponentIcons" Version="1.0.0" />
    <PackageVersion Include="Kentico.Xperience.Core.Tests" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.ImageProcessing" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.Labs.ComponentRegistry.Admin" Version="3.0.0" />
    <PackageVersion Include="Kentico.Xperience.Labs.ComponentRegistry.MCP" Version="3.0.0" />
    <PackageVersion Include="Kentico.Xperience.Labs.ContentModelGraph.Admin" Version="2.0.0" />
    <PackageVersion Include="Kentico.Xperience.Labs.SimpleStats.Admin" Version="1.0.0-prerelease-2" />
    <PackageVersion Include="Kentico.Xperience.Labs.VirtualInbox.Admin" Version="2.0.0" />
    <PackageVersion Include="Kentico.Xperience.Labs.VirtualInbox.MCP" Version="2.0.0" />
    <PackageVersion Include="Kentico.Xperience.Lucene" Version="15.0.6" />
    <PackageVersion Include="Kentico.Xperience.MiniProfiler" Version="3.0.0" />
    <PackageVersion Include="Kentico.Xperience.Mjml" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.SendGrid" Version="31.10.2" />
    <PackageVersion Include="Kentico.Xperience.TagManager" Version="6.1.1" />
    <PackageVersion Include="Kentico.Xperience.WebApp" Version="31.10.2" />
    <!-- Transitive via Kentico.Xperience.ImageProcessing. Pinned explicitly: blog social images compose with it directly. Keep in step with the Xperience graph. -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <!-- Do not update - licensing restrictions for new versions limit commercial use -->
    <PackageVersion Include="Mediatr" Version="12.5.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Sidio.Sitemap.AspNetCore" Version="3.1.1" />
    <PackageVersion Include="Slugify.Core" Version="5.2.0" />
    <!-- Required by test projects using System.Configuration.ConfigurationManager APIs. -->
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.15" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.1" />
    <!-- Pinned for GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (MimeKit, Microsoft.Data.SqlClient pull vulnerable versions). Remove once those ship patched versions. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.ServiceModel.Syndication" Version="10.0.15" />
    <PackageVersion Include="Vite.AspNetCore" Version="2.4.1" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="XperienceCommunity.Compare" Version="1.3.0" />
    <PackageVersion Include="XperienceCommunity.FormClone" Version="2.0.0" />
    <PackageVersion Include="XperienceCommunity.PreviewComponentOutlines" Version="4.1.0" />
  </ItemGroup>
</Project>