@using Kentico.Content.Web.Mvc

@model Kentico.Community.Portal.Web.Features.Integrations.IntegrationsListViewModel

@*
    Every entry is server-rendered (crawlers, ItemList JSON-LD, #anchors).
    Search and type filter only hide non-matching entries - see integrationsHubComponent.js
*@
<div class="section pb-7" x-data="integrationsHub" @@hashchange.window="revealHash()">
    <div class="container">
        <form method="get" id="integrationsSearchForm" role="search" aria-label="Search extensions and integrations"
              @@submit.prevent>
            <div class="row justify-content-center">
                <div class="col-sm-10 col-lg-7">
                    <input type="search" name="q" class="form-control search rounded-pill"
                           placeholder="Search by name, description, type, or author"
                           aria-label="Search extensions and integrations" aria-controls="integrationsList"
                           data-testid="integrations-search" x-model.debounce.150ms="query">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                        <div>
                            <label for="integrationType">Filter by type</label>
                            <select id="integrationType" name="type"
                                    class="form-select form-select-sm w-auto d-inline"
                                    aria-controls="integrationsList" data-testid="integrations-type"
                                    x-model="type">
                                <option value="">(All types)</option>
                                @foreach (var type in Model.IntegrationTypes)
                                {
                                    <option value="@type.Name">@type.Title</option>
                                }
                            </select>
                        </div>
                        <p class="text-muted small mb-0" role="status" data-testid="integrations-count"
                           x-text="summary">@Model.Items.Count extensions</p>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="container">
        <p class="text-center mt-5" x-show="visibleCount === 0" x-cloak>
            No extensions match.
            <button type="button" class="btn btn-link p-0 align-baseline" @@click="reset()">Clear filters</button>
        </p>
        <div id="integrationsList" class="row gx-lg-6 gx-xxl-7 mt-sm-n2 mt-lg-n4">
            @foreach (var item in Model.Items)
            {
                string titleID = $"{item.Anchor}-title";

                <div id="@item.Anchor" data-testid="integration-entry" data-type="@item.Type.CodeName"
                     class="col-sm-6 col-lg-4 mt-3 mt-sm-5 mt-lg-6" x-show="matches($el)">
                    <article class="border rounded-3 p-3 d-flex flex-column h-100 widget-card"
                             aria-labelledby="@titleID">
                        @if (item.Logo.TryGetValue(out var logo))
                        {
                            <div class="text-center mb-3">
                                <img xpc-image="logo" class="img-fluid integration-logo" sizes="60px" decoding="async" />
                            </div>
                        }
                        <h3 id="@titleID" class="h3 mt-2 pt-1">
                            <a href="#@item.Anchor" class="text-dark text-decoration-none">@item.Title</a>
                        </h3>
                        <p><small class="text-muted">@item.Type.Title</small></p>

                        @if (item.AuthorLink.TryGetValue(out var link))
                        {
                            <p class="mt-2">by
                                <small>
                                    <a href="@link.URL" aria-label="View @link.Label's profile">@link.Label</a>
                                    @if (item.Business.TryGetValue(out var business))
                                    {
                                        <text>from</text>
                                        @if (business.URL.TryGetValue(out string? url))
                                        {
                                            <a href="@url" aria-label="Visit @business.Label website">@business.Label</a>
                                        }
                                        else
                                        {
                                            @business.Label
                                        }
                                    }
                                </small>
                            </p>
                        }

                        <p class="mt-2 flex-grow-1">@item.ShortDescription</p>

                        <div class="d-flex justify-content-around mt-3" data-search-skip>
                            @if (item.RepositoryURL.TryGetValue(out string? repositoryURL))
                            {
                                <a class="text-primary text-decoration-none widget-card-link link-chevron" href="@repositoryURL"
                                   aria-label="View @item.Title source code repository" rel="noopener noreferrer"
                                   target="_blank">Repository</a>
                            }
                            @if (item.LibraryURL.TryGetValue(out string? libraryURL))
                            {
                                <a class="text-primary text-decoration-none widget-card-link link-chevron" href="@libraryURL"
                                   aria-label="View @item.Title library documentation" rel="noopener noreferrer"
                                   target="_blank">Library</a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</div>
