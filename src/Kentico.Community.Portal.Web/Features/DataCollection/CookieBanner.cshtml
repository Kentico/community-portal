@using Kentico.Community.Portal.Web.Features.DataCollection

@model CookieBannerViewModel

@if (Model.HideBanner)
{
    return;
}

@*
    Heading and message: WebsiteCookieBannerSettingsContent (admin). The message embeds the Website
    tracking consent short text (CookieBannerViewComponent.TRACKING_CONSENT_TOKEN).
    No close button: the banner stays until a choice is made.
    method="post": the form tag helper renders the antiforgery token the endpoint validates.
*@
<form id="cookieBanner" method="post" hx-post hx-route="@CookiesController.ROUTE_SET_CONSENT" hx-swap="outerHTML"
    hx-target="#cookieBanner" test-id="cookieBanner">
    <input type="hidden" name="Source" value="@CookieConsentSource.Banner" />
    <div class="xpcookiebanner is-active position-relative" role="region" aria-label="Cookie consent">
        <div class="xpcookiebanner__inner container">
            <div class="xpcookiebanner__content">
                @if (!string.IsNullOrWhiteSpace(Model.Heading))
                {
                    <h2 class="xpcookiebanner__header h5" test-id="cookieBannerHeading">@Model.Heading</h2>
                }
                <div test-id="cookieBannerMessage">@Model.MessageHTML</div>
            </div>
            <div class="xpcookiebanner__ctas">
                <button type="submit" name="Choice" value="@CookieConsentChoice.AcceptAll"
                    class="btn btn-primary xpcookiebanner__cta" data-tracking-code="CookieBar_Accept"
                    test-id="cookieBannerAcceptAll">
                    Accept all
                </button>
                <button type="submit" name="Choice" value="@CookieConsentChoice.NecessaryOnly"
                    class="btn btn-outline-primary xpcookiebanner__cta" data-tracking-code="CookieBar_Necessary"
                    test-id="cookieBannerNecessaryOnly">
                    Necessary only
                </button>
            </div>
        </div>
    </div>
</form>
