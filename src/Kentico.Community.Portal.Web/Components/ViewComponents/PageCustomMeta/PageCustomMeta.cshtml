@using Kentico.Community.Portal.Web.Components.ViewComponents.PageCustomMeta

@model PageCustomMetaViewModel

<title>@Model.Title</title>

@if (Model.OGImageURL.TryGetValue(out string? ogImageURL))
{
    <meta name="image" property="og:image" content="@ogImageURL">
}

<meta name="title" property="og:title" content="@Model.Title" />
<meta name="description" property="og:description" content="@Model.Description" />
<meta name="type" property="og:type" content="@Model.OGType" />
<meta name="url" property="og:url" content="@Model.URL" />
<meta name="site_name" property="og:site_name" content="@Model.SiteName">

@if (Model.Article.TryGetValue(out var article))
{
    <meta property="article:published_time" content="@article.PublishedTime.ToString("s")" />
    if (article.ModifiedTime.TryGetValue(out var modifiedTime))
    {
        <meta property="article:modified_time" content="@modifiedTime.ToString("s")" />
    }
    <meta property="article:author" content="@article.AuthorURL.GetValueOrDefault(article.AuthorName)" />
    <meta name="author" content="@article.AuthorName">
}

<meta name="twitter:card" content="@Model.TwitterCard" />
<meta name="twitter:title" content="@Model.Title" />
<meta name="twitter:description" content="@Model.Description" />
@if (Model.OGImageURL.TryGetValue(out string? twitterImageURL))
{
    <meta name="twitter:image" content="@twitterImageURL" />
}

@foreach (var feed in Model.Feeds)
{
    <link rel="alternate" type="application/rss+xml" title="@feed.Title" href="@feed.URL">
}

<meta name="apple-mobile-web-app-title" content="@Model.Title">
<meta name="mobile-web-app-capable" content="yes">

@if (Model.MetaRobotsContent.TryGetValue(out string? robots))
{
    <meta name="robots" content="@robots">
}

<link rel="manifest" href="/manifest/site.webmanifest">
<link rel="apple-touch-icon" sizes="180x180" href="/manifest/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/manifest/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/manifest/favicon-16x16.png">
<link rel="mask-icon" href="/manifest/safari-pinned-tab.svg" color="#5bbad5">
<meta name="msapplication-TileColor" content="#da532c">
<meta name="theme-color" content="#ffffff">

@if (Model.CanonicalURL.TryGetValue(out var url))
{
    <link name="canonical" rel="canonical" href="@url">
}

@if (Model.GoogleSiteVerification.TryGetValue(out string? googleVerification))
{
    <meta name="google-site-verification" content="@googleVerification" />
}

@if (Model.BingSiteVerification.TryGetValue(out string? bingVerification))
{
    <meta name="msvalidate.01" content="@bingVerification" />
}

@* No request: the reCAPTCHA script loads only where a captcha is used (RecaptchaScript) *@
@if (Model.CaptchaSiteKey.TryGetValue(out string? recaptchaKey))
{
    <meta name="captchaSiteKey" content="@recaptchaKey">
}

<meta name="htmx-config" includeAspNetAntiforgeryToken="true" />

<vc:json-ld />