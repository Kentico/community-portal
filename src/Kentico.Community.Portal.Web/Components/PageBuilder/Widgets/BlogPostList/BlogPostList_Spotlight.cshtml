@using Kentico.Community.Portal.Web.Components.PageBuilder.Widgets.BlogPostList
@model BlogPostListWidgetViewModel

@* Spotlight — promotes the first post with a large title and an explicit CTA, then
   lists any remaining posts as compact rows beneath it. Built for a landing page
   that leads with one post, and for a single-post "read this next" placement. *@

@{
  var lead = Model.BlogPosts[0];
  var rest = Model.BlogPosts.Skip(1).ToList();
}

<section class="blog-post-list blog-post-list--spotlight" xpc-preview-outline="@Model.ComponentName"
  aria-label="@(Model.Heading.GetValueOrDefault("Blog posts"))">

  <partial name="~/Components/PageBuilder/Widgets/BlogPostList/_Header.cshtml" model="Model" />

  <article class="blog-post-list__lead position-relative">
    <h3 class="blog-post-list__title blog-post-list__title--lead fs-2 fw-bold mt-0 mb-2">
      <a href="@lead.LinkPath" class="blog-post-list__title-link text-decoration-none"
        @(lead.Description.HasValue ? $"aria-describedby={lead.DescriptionID}" : null)>
        @lead.Title
      </a>
    </h3>

    <partial name="~/Components/PageBuilder/Widgets/BlogPostList/_Meta.cshtml" model="lead" />

    <partial name="~/Components/PageBuilder/Widgets/BlogPostList/_Description.cshtml" model="lead" />

    @* Badges stay with the post's other metadata, above the CTA, so the footer holds
       nothing but the action. *@
    <partial name="~/Components/PageBuilder/Widgets/BlogPostList/_Tags.cshtml" model="lead" />

    <footer class="mt-3">
      <a class="btn btn-primary btn-sm d-inline-flex align-items-center" href="@lead.LinkPath">
        Read the post
        <svg class="blog-post-list__arrow ms-2" width="15" height="15" viewBox="0 0 16 16" fill="none"
          aria-hidden="true">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </a>
    </footer>
  </article>

  @if (rest.Count > 0)
  {
    <ul class="blog-post-list__rows list-unstyled m-0 mt-3">
      @foreach (var post in rest)
      {
        <li class="blog-post-list__row position-relative">
          <h4 class="blog-post-list__title fs-4 fw-bold m-0">
            <a href="@post.LinkPath"
              class="blog-post-list__title-link stretched-link text-decoration-none">
              <span>@post.Title</span>
              <svg class="blog-post-list__arrow text-primary" width="15" height="15" viewBox="0 0 16 16" fill="none"
                aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
            </a>
          </h4>

          <partial name="~/Components/PageBuilder/Widgets/BlogPostList/_Meta.cshtml" model="post" />
        </li>
      }
    </ul>
  }
</section>
