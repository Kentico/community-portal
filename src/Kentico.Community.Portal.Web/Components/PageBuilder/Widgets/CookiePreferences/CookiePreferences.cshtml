@using Kentico.Community.Portal.Web.Components.PageBuilder.Widgets.CookiePreferences
@using Kentico.Community.Portal.Web.Features.DataCollection
@using Kentico.Community.Portal.Core.DataProtection
@using Kentico.Community.Portal.Web.Infrastructure

@model CookiePreferencesWidgetViewModel

@{
    var copy = Model.Copy;
    var settings = Model.Settings;
}

<div id="cookie-settings" class="container" xpc-preview-outline="Cookie Preferences Widget">
    @* method="post": the form tag helper renders the antiforgery token the endpoint validates *@
    <form class="cookie-settings" method="post" hx-post hx-route="@CookiesController.ROUTE_SET_CONSENT"
        hx-target="#cookieSettingsResult" hx-swap="outerHTML" test-id="cookieSettings">
        <input type="hidden" name="Source" value="@CookieConsentSource.Settings" />

        <h2>@copy.Heading</h2>
        <p>@copy.Intro</p>

        <div class="cookie-settings__category">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="cookieSettingsNecessary" checked disabled />
                <label class="form-check-label fw-bold" for="cookieSettingsNecessary">Necessary <span class="badge text-bg-secondary ms-1">Always on</span></label>
            </div>
            <p>@copy.NecessaryDescription</p>
        </div>

        <div class="cookie-settings__category">
            <div class="form-check form-switch">
                <partial name="~/Components/PageBuilder/Widgets/CookiePreferences/_CookieSettingsSwitch.cshtml"
                    model="CookieSettingsSwitches.Analytics(settings)" />
                <label class="form-check-label fw-bold" for="@CookieSettingsSwitches.ANALYTICS_ID">Analytics</label>
            </div>
            <p>@copy.AnalyticsDescription</p>
        </div>

        <div class="cookie-settings__category">
            <div class="form-check form-switch">
                <partial name="~/Components/PageBuilder/Widgets/CookiePreferences/_CookieSettingsSwitch.cshtml"
                    model="CookieSettingsSwitches.Tracking(settings)" />
                <label class="form-check-label fw-bold" for="@CookieSettingsSwitches.TRACKING_ID">Website tracking &amp; personalization</label>
            </div>
            @if (settings.IsReadOnly)
            {
                <p class="text-muted" test-id="cookieSettingsReadOnly">@CookieSettingsViewModel.READ_ONLY_NOTE</p>
            }
            <vc:consent consent-name="@ConsentCodeNames.WEBSITE_TRACKING" />
            <details>
                <summary>More details</summary>
                <vc:consent consent-name="@ConsentCodeNames.WEBSITE_TRACKING" full-text="true" />
            </details>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" name="Choice" value="@CookieConsentChoice.Save" class="btn btn-primary"
                test-id="cookieSettingsSave">Save choices</button>
            <button type="submit" name="Choice" value="@CookieConsentChoice.AcceptAll" class="btn btn-outline-primary"
                test-id="cookieSettingsAcceptAll">Accept all</button>
            <button type="submit" name="Choice" value="@CookieConsentChoice.NecessaryOnly" class="btn btn-outline-primary"
                test-id="cookieSettingsNecessaryOnly">Necessary only</button>
        </div>

        <partial name="~/Components/PageBuilder/Widgets/CookiePreferences/_CookieSettingsResult.cshtml" model="settings" />

        @if (settings.IsMember)
        {
            <p class="text-muted">@copy.MemberNote</p>
        }

        <p class="text-muted">@copy.SignOutNote</p>
    </form>
</div>
