@using Kentico.Community.Portal.Web.Components.PageBuilder.Sections
@using Kentico.Community.Portal.Web.Components.PageBuilder.Sections.Grid

@model GridSectionViewModel

@{
  string containerClass = (Model.Layout, Model.ContentWidth) switch
  {
    (Layouts._1_Column_Full_Width, _) => "",
    (_, ContentWidths.Narrow) => "container section-container-narrow",
    _ => "container"
  };

  string columnsClass = (Model.Layout, Model.ColumnBreakpoint) switch
  {
    (Layouts._3_Columns_33_33_33, ColumnBreakpoints.Extra_Large) => "row-cols-1 row-cols-xl-3",
    (Layouts._3_Columns_33_33_33, _) => "row-cols-1 row-cols-lg-3",
    (Layouts._2_Columns_50_50, ColumnBreakpoints.Extra_Large) => "row-cols-1 row-cols-xl-2",
    (Layouts._2_Columns_50_50, ColumnBreakpoints.Large) => "row-cols-1 row-cols-lg-2",
    (Layouts._2_Columns_50_50, _) => "row-cols-1 row-cols-md-2",
    _ => "row-cols-1",
  };

  string bodyAlignmentClass = Model.BodyAlignment switch
  {
    Alignments.Center => "d-flex justify-content-center",
    Alignments.Left or _ => "",
  };

  var (backgroundColorClass, backgroundColorProperty) = Model.BackgroundColor switch
  {
    SectionBackgroundColors.Primary_Light => ("bg-orange-100", "--bs-orange-100-rgb"),
    SectionBackgroundColors.Secondary_Light => ("bg-purple-100", "--bs-purple-100-rgb"),
    SectionBackgroundColors.Light => ("bg-light", "--bs-light-rgb"),
    SectionBackgroundColors.White or _ => ("", ""),
  };

  string paddingTopClass = Model.PaddingTop switch
  {
    VerticalPaddings.Large => "pt-7",
    VerticalPaddings.Medium_Large => "pt-6",
    VerticalPaddings.Medium => "pt-5",
    VerticalPaddings.Small => "pt-3",
    VerticalPaddings.None => "pt-0",
    _ => "pt-0"
  };

  string paddingBottomClass = Model.PaddingBottom switch
  {
    VerticalPaddings.Large => "pb-7",
    VerticalPaddings.Medium_Large => "pb-6",
    VerticalPaddings.Medium => "pb-5",
    VerticalPaddings.Small => "pb-3",
    VerticalPaddings.None => "pb-0",
    _ => "pb-0"
  };

  string pageBuilderClass = View.PageBuilderMode switch
  {
    ApplicationPageBuilderMode.Edit => "page-builder-edit",
    _ => ""
  };
}

<div test-id="gridSection" class="section @paddingTopClass @paddingBottomClass @backgroundColorClass @pageBuilderClass"
     style="--section-bg-color: rgb(var(@backgroundColorProperty))" xpc-preview-outline="Grid Section">
  <div class="@containerClass">
    @if (!string.IsNullOrWhiteSpace(Model.Heading))
    {
      string slug = View.SlugHelper.GenerateSlug($"gridSection-{Model.Heading}");

      string alignmentClass = Model.HeadingAlignment switch
      {
        Alignments.Center => "text-center",
        Alignments.Left or _ => "text-left"
      };

      string spacingClass = Model.HeadingSpacing switch
      {
        HeadingSpacings.Large => "section-heading-gap-lg",
        HeadingSpacings.Medium => "section-heading-gap-md",
        HeadingSpacings.Default or _ => ""
      };

      <h2 id="@slug" class="heading @alignmentClass @spacingClass">@Model.Heading
        @if (Model.IsHeadingAnchorLinkVisible)
        {
          <a title="Navigate to this heading" aria-label="Navigate to this heading" class="heading-link"
             href="#@(slug)"></a>
        }
      </h2>
    }

    <div class="row @columnsClass gy-5 @bodyAlignmentClass">
      @foreach (int i in Enumerable.Range(1, Model.WidgetZoneCount))
      {
        string columnClass = Model.Layout switch
        {
          Layouts._1_Column_Narrow => "col-12 col-lg-6",
          Layouts._1_Column_Max_Width_Limited => "col-xl-10 col-xxl-9",
          _ => "col"
        };

        <div class="@columnClass d-flex flex-column gap-3">
          <widget-zone />
        </div>
      }
    </div>
  </div>
</div>