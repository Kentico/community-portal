<?xml version="1.0" encoding="utf-8"?>
<RepositoryConfiguration Version="2"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

     <RestoreMode>CreateUpdate</RestoreMode>

     <!-- Release 31.10.2.5 (#392, SEO follow-up). Opt-in (v2): only these objects deploy.
          - cms.systemtable CMS.Member + cms.alternativeform Edit / ProfileOverview (#392):
            MemberAlternateEmail, MemberAlternateEmailVerifiedDate, MemberEmailConfirmedDate.
            The parent system table is listed so its child alternative forms are processed.
          - Member email verification and email changed notification emails (#392): content items of type
            KenticoCommunity.AutoresponderEmail, filtered by item name to the 2 new emails only. The
            content type must also be in the cms.contenttype filter, or no items are stored.
            v2 rejects content item and email object types in IncludedObjectTypes.
          - 20261118_01_MemberEmailConfirmedDateBackfill runs from After.txt (#392).
          - cms.contenttype KenticoCommunity.WebsiteGlobalContent: site verification fields (#384,
            carried from 31.10.2.4) and robots.txt field explanation text.
          - cms.class CMS.ContentItemCommonData: WebPageMetaFields "Sitemap - exclude" explanation text.
            Overwrites all reusable field schemas with the repository definitions.
          - Page and global content values (sitemap exclusions, robots.txt, verification values) are
            set manually in PROD, not by CD or Content Sync. -->
     <IncludedObjectTypes>
          <ObjectType>cms.systemtable</ObjectType>
          <ObjectType>cms.alternativeform</ObjectType>
          <ObjectType>cms.class</ObjectType>
          <ObjectType>cms.contenttype</ObjectType>
     </IncludedObjectTypes>

     <!-- Q&A answers bind to cms.webpageitem, so including content items pulls them in. Never deploy them. -->
     <ExcludedObjectTypes>
          <ObjectType>kenticocommunity.qandaanswerdata</ObjectType>
     </ExcludedObjectTypes>

     <ObjectFilters>
          <IncludedCodeNames ObjectType="cms.systemtable">
               CMS.Member
          </IncludedCodeNames>
          <IncludedCodeNames ObjectType="cms.alternativeform">
               Edit;
               ProfileOverview
          </IncludedCodeNames>
          <IncludedCodeNames ObjectType="cms.class">
               CMS.ContentItemCommonData
          </IncludedCodeNames>
          <IncludedCodeNames ObjectType="cms.contenttype">
               KenticoCommunity.WebsiteGlobalContent;
               KenticoCommunity.AutoresponderEmail
          </IncludedCodeNames>
     </ObjectFilters>

     <IncludedContentItemsOfType>
          <ContentType>KenticoCommunity.AutoresponderEmail</ContentType>
     </IncludedContentItemsOfType>

     <ContentItemFilters>
          <IncludedContentItemNames>
               MemberEmailChangedNotification-p7w4rz5t;
               MemberEmailVerification-k3v9qx2m
          </IncludedContentItemNames>
     </ContentItemFilters>

</RepositoryConfiguration>
