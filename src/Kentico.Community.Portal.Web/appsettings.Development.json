{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "KenticoEventLog": {
      "LogLevel": {
        "Default": "Error",
        "Microsoft.AspNetCore.Server.Kestrel": "None"
      }
    }
  },

  "__comment_IndexNow": "Test key so E2E can verify the key file. Empty Endpoint: nothing is submitted.",
  "IndexNow": {
    "Key": "e2e-indexnow-test-key",
    "Endpoint": ""
  },

  "CMSHashStringSalt": "hash-string-salt",

  "CMSAdminSettings": {
    "Authentication": {
      "Identity": {
        "AzureAD": {
          "Domain": "ci-domain.onmicrosoft.com",
          "TenantId": "ci-tenant-id",
          "ClientId": "ci-client-id",
          "Instance": "https://login.microsoftonline.com/",
          "CallbackPath": "/admin-oidc"
        }
      }
    }
  },

  "CMSHeadless": {
    "AllowIntrospection": true,
    "EnableTracking": false,
    "GraphQlEndpointPath": "/api/headless",
    "CorsAllowedOrigins": "*",
    "CorsAllowedHeaders": "Authorization;Cache-Control;Content-Type",
    "Caching": {
      "AbsoluteExpiration": "360"
    }
  },

  "__CMSHeadless_LOCAL": {
    "Purpose": "Use this TEST headless API key for local development",
    "APIKey": "o1fmoz6Jh+J509NBvHA6n4qKzgBFxXbs"
  },

  "__comment_AutomationTiming": "Shortened so automation emails (e.g. MemberWelcome) reach the E2E specs fast. Production: CMSProcessContactActionsInterval 30 (appsettings.json), SchedulerOptions.SecondsInterval 30, EmailQueueOptions.LoadInterval 60000.",
  "CMSProcessContactActionsInterval": 2,
  "SchedulerOptions": {
    "SecondsInterval": 1
  },

  "__comment_EmailMarketingOptions": "Earlier than EmailMarketingOptions.CONSENT_GO_LIVE (the default) so E2E specs can seed a confirmation dated before the cutoff.",
  "EmailMarketingOptions": {
    "AgreementCutoffDate": "2026-01-01"
  },

  "EmailQueueOptions": {
    "ArchiveDuration": 14,
    "LoadInterval": 1000
  },

  "Kentico.Xperience.Lucene.Custom": {
    "WebCrawlerBaseUrl": "https://localhost:45039/"
  },

  "Kentico.Xperience.MiniProfiler.Custom": {
    "IsEnabled": false
  },

  "Kentico.Xperience.ManagementApi": {
    "Secret": "rrvpzpu18m5385tfw1h9j5luxton5vyv"
  },

  "SystemDomains": {
    "WebBaseUrl": "https://localhost:45040"
  },

  "SystemEmailOptions": {
    "SendingDomain": "community.kentico.com",
    "ServiceDomain": "localhost:45040"
  },

  "ReCaptcha": {
    "SiteKey": "key",
    "SecretKey": "secret",
    "ScoreThreshold": 0.2,
    "IsValidationDisabled": true
  },

  "SmtpOptions": {
    "Server": {
      "Host": "localhost",
      "Port": 1025
    }
  },

  "Cache": {
    "Query": {
      "IsEnabled": true,
      "IsSlidingExpiration": false,
      "CacheItemDuration": 1
    }
  },

  "Kentico": {
    "VirtualInbox": {
      "Enabled": true,
      "Mcp": {
        "Path": "/mcp/virtual-inbox"
      }
    }
  },

  "__comment_RateLimiting": "Raised so the full E2E suite (many registrations/sign-ins from one IP) doesn't hit the limits. Production defaults: RateLimitingOptions.",
  "RateLimiting": {
    "Login": { "PermitLimit": 1000 },
    "Registration": { "PermitLimit": 1000 },
    "ForgotPassword": { "PermitLimit": 1000 },
    "UpdateAvatar": { "PermitLimit": 1000 },
    "EmailVerification": { "PermitLimit": 1000 },
    "CreateQuestion": { "PermitLimit": 1000 },
    "CreateAnswer": { "PermitLimit": 1000 },
    "UpdateQuestion": { "PermitLimit": 1000 },
    "UpdateAnswer": { "PermitLimit": 1000 },
    "UpdateQuestionSubscription": { "PermitLimit": 1000 },
    "UpdateQuestionReaction": { "PermitLimit": 1000 },
    "UpdateAnswerReaction": { "PermitLimit": 1000 }
  },

  "Testing": {
    "E2E": {
      "Enabled": true
    }
  },

  "Vite": {
    "Base": "dist/",
    "Server": {
      "AutoRun": false,
      "Port": 5174,
      "Https": true
    }
  },

  "CMSAdminClientModuleSettings": {
    "kentico-community-portal-web-admin": {
      "Mode": "Proxy",
      "Port": 3099,
      "UseSSL": true
    }
  }
}
